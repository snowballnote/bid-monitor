# Docker Compose database initialization
POSTGRES_DB=bid_monitor
POSTGRES_USER=bid_monitor
POSTGRES_PASSWORD=

# Biz Assist postgres profile and PostgreSQL integration test
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bid_monitor
DB_USER=bid_monitor
